{
  "name": "ocpp-gateway-cloudflare",
  "version": "0.0.0",
  "private": true,
  "description": "Example: run ocpp-gateway in a Cloudflare Container behind a minimal Worker.",
  "license": "MIT",
  "scripts": {
    "predev": "npm --prefix ../.. run build",
    "dev": "grep -v '\"routes\"' wrangler.jsonc > wrangler.local.jsonc && wrangler dev -c wrangler.local.jsonc",
    "predeploy": "npm --prefix ../.. run build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "predry-run": "npm --prefix ../.. run build",
    "dry-run": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.159.0"
  }
}
