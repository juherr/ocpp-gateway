# ── Server ────────────────────────────────────────────────────
PORT=9000

# ── Routing table (per-chargeBoxId) ──────────────────────────
# Path to the JSON routing table. Each charge point is matched by
# its chargeBoxId; unmatched ids fall back to the "default" route.
# See routes.example.json for the schema.
ROUTES_FILE=./routes.json

# ── Multi-tenant (optional) ───────────────────────────────────
# Tenants are subdomains of this domain: acme.ocpp.example.com -> "acme".
# Per-tenant routes live under "tenants" in the routes file.
# TENANT_BASE_DOMAIN=ocpp.example.com

# Header carrying the hostname the charger dialled, set by a TRUSTED reverse
# proxy that strips any client-supplied value. Unset: the Host header is used.
# TENANT_HOST_HEADER=x-forwarded-host

# ── Logging ───────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL=info

# Maximum number of characters for debug payload summaries.
# Leave empty to disable truncation.
LOG_DEBUG_MESSAGE_MAX_LENGTH=120
