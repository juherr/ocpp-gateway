{
  "name": "ocpp-gateway",
  "version": "0.1.0",
  "description": "OCPP 1.6/2.0.1 WebSocket gateway that routes each charge point to its own primary CSMS (bidirectional) and read-only secondary mirrors, via a per-chargeBoxId routing table.",
  "keywords": [
    "charge-point",
    "csms",
    "electric-vehicle",
    "ev-charging",
    "gateway",
    "ocpp",
    "ocpp-1.6",
    "ocpp-2.0",
    "proxy",
    "websocket"
  ],
  "homepage": "https://github.com/juherr/ocpp-gateway",
  "bugs": {
    "url": "https://github.com/juherr/ocpp-gateway/issues"
  },
  "license": "MIT",
  "author": "Julien Herr",
  "contributors": [
    "Joulo B.V. <info@joulo.nl> (https://joulo.nl)"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/juherr/ocpp-gateway.git"
  },
  "main": "dist/index.cjs",
  "scripts": {
    "build": "vp pack",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "start": "node --enable-source-maps dist/index.cjs",
    "dev": "vp pack --watch & node --enable-source-maps --watch dist/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "vp lint && vp fmt --check",
    "format": "vp fmt --write && vp lint --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/node": "^11.11.0",
    "mongodb": "^7.8.0",
    "ws": "^8.22.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@open-ocpp-trace/core": "^0.1.0",
    "@open-ocpp-trace/jsonl": "^0.1.0",
    "@open-ocpp-trace/viewer-standalone": "file:vendor/open-ocpp-trace-viewer-standalone-0.0.0.tgz",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "@types/ws": "^8.18.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prismjs": "^1.30.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.5.1",
    "vitest": "5.1.0"
  },
  "lint-staged": {
    "*.{ts,mts,js,mjs,cjs}": [
      "vp fmt --write",
      "vp lint --fix"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
